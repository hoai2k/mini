{
  "name": "Games Chat",
  "short_name": "Games Chat",
  "description": "Video chat with silly face effects and minigames.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
